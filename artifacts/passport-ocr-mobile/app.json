{
  "expo": {
    "name": "LEO OS",
    "slug": "leo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "passport-ocr-mobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fbf6ec"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.leo.os",
      "infoPlist": {
        "NSCameraUsageDescription": "We use the camera to capture passport pages for OCR extraction.",
        "NSPhotoLibraryUsageDescription": "We access your photo library so you can choose passport photos to upload.",
        "NSDocumentsFolderUsageDescription": "We access documents so you can upload passport PDFs.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.leo.os",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#fbf6ec"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow LEO OS to access your camera to capture passports.",
          "photosPermission": "Allow LEO OS to access your photos to upload passport scans."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "8e4ff442-aea5-49de-885f-e2595de2a0a7"
      }
    },
    "owner": "adhuhaam",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8e4ff442-aea5-49de-885f-e2595de2a0a7"
    }
  }
}
