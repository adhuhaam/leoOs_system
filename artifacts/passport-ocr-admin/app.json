{
  "expo": {
    "name": "Sky Office",
    "slug": "leo-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.jpeg",
    "scheme": "passport-ocr-admin",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/app-icon.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#0d2e28"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.leo.admin",
      "infoPlist": {
        "NSCameraUsageDescription": "We use the camera to capture passport pages for OCR extraction.",
        "NSPhotoLibraryUsageDescription": "We access your photo library so you can choose passport photos to upload.",
        "NSDocumentsFolderUsageDescription": "We access documents so you can upload passport PDFs.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "transparent",
      "barStyle": "dark-content"
    },
    "android": {
      "package": "com.leo.admin",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.jpeg",
        "backgroundColor": "#0d2e28"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/images/app-icon.jpeg"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Sky Office to access your camera to capture passports.",
          "photosPermission": "Allow Sky Office to access your photos to upload passport scans."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "adhuhaam",
    "extra": {
      "eas": {
        "projectId": "930da1e8-b735-40c9-b04a-f71604dbceeb"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false
    }
  }
}
